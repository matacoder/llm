# Настройки для локальной LLM системы

# Порт для доступа к Open WebUI
WEBUI_PORT=3000

# Порт для Ollama API
OLLAMA_PORT=11434

# Модели для загрузки (через запятую)
# Рекомендуемые модели для русского языка (2025):
# - gpt-oss:20b - новейшая от OpenAI, отличное качество, agentic capabilities, ~14GB (РЕКОМЕНДУЕТСЯ)
# - qwen2.5:14b - отличное качество, ~9GB VRAM
# - qwen2.5:7b - быстрая, хорошее качество, ~5GB VRAM
# - llama3.3:70b - топовая, но тяжелая, ~42GB
MODELS_TO_DOWNLOAD=gpt-oss:20b

# Модель для эмбеддингов (для работы с документами)
# mxbai-embed-large - лучшая для русского языка (669MB)
EMBEDDING_MODEL=mxbai-embed-large

# ========================================
# Настройки автосинхронизации документов
# ========================================

# API токен для доступа к Open WebUI
# Получить: Open WebUI → Settings → Account → API Keys → Create new secret key
OWUI_TOKEN=your-api-key-here

# ID коллекции Knowledge для загрузки документов
# Получить: Open WebUI → Workspace → Knowledge → выберите коллекцию → скопируйте ID из URL
# Например, если URL: http://localhost:3000/workspace/knowledge/abc-123-def
# То OWUI_KNOWLEDGE_ID=abc-123-def
OWUI_KNOWLEDGE_ID=your-knowledge-id-here

# ========================================
# Дополнительные настройки (опционально)
# ========================================

# Интервал проверки удаленных файлов (секунды)
# По умолчанию: 300 (5 минут)
# Минимум рекомендуемый: 60 (1 минута)
# CLEANUP_INTERVAL=300
